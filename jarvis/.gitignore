# Jarvis AI Assistant — .gitignore

# ── Secrets ───────────────────────────────────────────────────────────────────
.env
*.key

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
eggs/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Data & Logs (user-specific, don't commit) ─────────────────────────────────
data/conversation_memory.json
data/tasks.json
logs/
*.log

# ── AI Models (large files) ───────────────────────────────────────────────────
*.bin
*.pt
*.gguf
models/

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Screenshots ───────────────────────────────────────────────────────────────
Pictures/Jarvis Screenshots/

# ── Test artifacts ────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# Keep data dir structure
!data/.gitkeep
